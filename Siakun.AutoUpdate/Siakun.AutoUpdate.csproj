<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <Authors>Siakun</Authors>
    <Description>GitHub Releases와 Velopack을 사용하는 데스크톱 앱의 업데이트 및 버전 전환 라이브러리입니다.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- INTENT: 표준 라이선스는 SPDX 식으로 적어 nuget.org와 패키지 도구가 라이선스를 인식하게 한다.
         전문은 저장소 루트의 LICENSE에 있다. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/siakun/Siakun.AutoUpdate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <!-- INTENT: PROJECT.md에 적은 Velopack 동작은 이 버전의 소스로 확인했다. 버전을 올리면 그 문서의
         확인 절차를 다시 거친다. -->
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="NuGet.Versioning" Version="6.14.0" />
    <InternalsVisibleTo Include="Siakun.AutoUpdate.Tests" />
    <!-- INTENT: README는 저장소 루트에 하나만 두어 GitHub 첫 화면과 패키지 설명이 같은 파일을 사용하게 한다.
         프로젝트 폴더 밖 파일이라 Include로 추가하고, 솔루션 탐색기에는 코드만 보이게 숨긴다. -->
    <None Include="../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
